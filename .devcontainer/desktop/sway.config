# The devcontainer's virtual desktop (`just desktop`): one headless output, sized by the
# recipe like a common screen, no bar, no borders, so a window's tree rect is exactly the
# pixels grim captures. A window fills the screen, as a maximized one does;
# `just desktop-window float` makes it a normal window instead. The cursor is drawn into the
# output, so it hides a second after it last moved.
output HEADLESS-1 resolution 1920x1080 position 0 0 bg #3b4252 solid_color
default_border none
default_floating_border none
focus_follows_mouse no
xwayland disable
seat * hide_cursor 1000

# A headless seat has no input devices, and a device that tools plug in only while they
# run reaches the app too late for their first event. Keep a pointer and a keyboard
# plugged in for as long as the desktop runs (wtype's keyboard sleeps ~23 days).
exec python3 .devcontainer/desktop/seat.py
exec wtype -s 2000000000

# Tell `just desktop` where this desktop lives, for later shells to source.
exec printf 'export XDG_RUNTIME_DIR=%s WAYLAND_DISPLAY=%s SWAYSOCK=%s\n' "$XDG_RUNTIME_DIR" "$WAYLAND_DISPLAY" "$SWAYSOCK" > "$STUDY_DESKTOP_ENV"
