// The default development container runs Study and the agent team.
{
  "name": "Study",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "options": ["--platform=linux/amd64"]
  },
  // One rendering architecture for local and CI references, including ARM hosts.
  "runArgs": ["--platform=linux/amd64"],
  // Docker inside the container, available for development services:
  // their containers' ports then answer on localhost, as testcontainers expects. Docker CE,
  // not moby: trixie has no moby packages.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.2": {
      "moby": false
    }
  },
  // Shared web app; forwarding never opens a browser or starts a server.
  "appPort": ["127.0.0.1:5173:5173"],
  "portsAttributes": {
    "5173": { "label": "Study web", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "DavidAnson.vscode-markdownlint",
        "GitHub.vscode-github-actions",
        "VoidZero.vite-plus-extension-pack",
        "ms-azuretools.vscode-containers",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "redhat.vscode-yaml",
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "timonwong.shellcheck",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "[javascript][javascriptreact][typescript][typescriptreact]": {
          "editor.defaultFormatter": "oxc.oxc-vscode",
          "editor.formatOnSave": true,
          "editor.formatOnSaveMode": "file",
          "editor.codeActionsOnSave": { "source.fixAll.oxc": "explicit" }
        },
        "oxc.disableNestedConfig": true,
        "oxc.fmt.disableNestedConfig": true,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer",
          "editor.formatOnSave": true
        },
        "[yaml]": {
          "editor.defaultFormatter": "redhat.vscode-yaml"
        },
        "files.watcherExclude": {
          "**/target/**": true
        },
        "rust-analyzer.check.command": "check",
        "rust-analyzer.linkedProjects": ["Cargo.toml"],
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteEnv": {
    "CARGO_TARGET_DIR": "${containerWorkspaceFolder}/target/devcontainer",
    "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}",
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
    "source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind",
    "source=${localEnv:HOME}/.codex,target=/home/vscode/.codex,type=bind",
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind",
    "source=${localEnv:HOME}/.config/study-devcontainer,target=/home/vscode/.config/study-devcontainer,type=bind,readonly"
  ],
  "initializeCommand": "bash tooling/scripts/devcontainer/initialize.sh",
  "waitFor": "postCreateCommand",
  "postCreateCommand": "python3 tooling/scripts/devcontainer/post-create.py",
  // Desktop/noVNC tooling stays installed and starts only when explicitly requested.
  "postStartCommand": {
    "graphify": "graphify extract . --code-only --cargo --no-cluster --max-workers 4"
  },
  "containerEnv": {
    "RUST_BACKTRACE": "1"
  }
}
