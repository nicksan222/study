    "gen": "drizzle-kit generate",
    "gen:check": "node --test --test-name-pattern=\"Drizzle generation\" test/schema.test.ts"
  },
  "dependencies": {
    "@study/theme": "*",
    "drizzle-orm": "1.0.0-rc.5"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.5"
  }
}
