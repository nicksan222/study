{
  "name": "@study/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "check:generated": "node --test --test-name-pattern=\"Drizzle generation\" test/schema.test.ts",
    "check:schema": "drizzle-kit check",
