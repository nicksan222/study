{
  "name": "@study/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#client/*": "./src/*"
  },
  "exports": {
    "./feature-previews": "./src/feature-previews/index.tsx",
    "./feature-previews/catalog": "./src/feature-previews/catalog.ts"
  },
  "scripts": {
    "dev": "bun --bun vp dev",
    "build": "bun --bun vp build",
    "typecheck": "bun --bun vp run gen:routes && bun --bun tsc --noEmit",
    "gen:routes": "bun --bun tsr generate",
    "test": "bun --bun vp test run --config ../../vite.config.ts --project @study/client --exclude \"../../packages/**\" --reporter=verbose",
    "e2e": "bun --bun playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@study/contracts": "*",
    "@study/icons": "*",
    "@study/localization": "*",
    "@study/server": "*",
    "@study/ui": "*",
    "@tanstack/react-router": "^1.170.46",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "effect": "4.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.7",
    "@study/db": "*",
    "@study/testing": "*",
    "@study/tooling": "*"
  }
}
