{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Study main window: private server discovery and ChatGPT sign-in.",
  "windows": ["main"],
  "permissions": [
    "allow-server-connection",
    "allow-desktop-update",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-diagnostic-log",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://auth.openai.com/api/accounts/authorize*"
        },
        {
          "url": "https://login.microsoftonline.com/consumers/oauth2/v2.0/authorize*"
        },
        {
          "url": "https://accounts.google.com/o/oauth2/v2/auth*"
        },
        {
          "url": "https://www.dropbox.com/oauth2/authorize*"
        }
      ]
    }
  ]
}
