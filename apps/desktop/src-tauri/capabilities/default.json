{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Study main window: private server discovery and ChatGPT sign-in.",
  "windows": ["main"],
  "permissions": [
    "allow-server-connection",
    "allow-desktop-update",
    "allow-diagnostic-log",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://auth.openai.com/api/accounts/authorize*"
        }
      ]
    }
  ]
}
