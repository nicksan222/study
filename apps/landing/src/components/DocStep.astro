---
import DocView from './DocView.astro';
import Icon from './Icon.astro';
import { landingCopy } from '@study/localization';
import type { Lang } from '../i18n/strings';
import type { DocExample } from '../i18n/doc-examples';

interface Props {
  number?: number;
  kind?: 'workflow' | 'reference';
  example?: DocExample;
  phase?: 'start' | 'result';
}

const { number, kind = 'workflow', example, phase } = Astro.props;

const lang = (Astro.currentLocale ?? 'en') as Lang;

const hasDetails = Astro.slots.has('default');
---
<section class:list={['doc-step', kind, { 'has-view': example }]}>
  <div class="step-copy">
    {number && <span class="step-number" aria-hidden="true">{String(number).padStart(2, '0')}</span>}
    <slot name="intro" />
    <div class="step-instructions">{kind === 'workflow' ? hasDetails && <details><summary><Icon name="chevron-right" size={14} />{landingCopy[lang].docsStepDetails}</summary><slot /></details> : <slot />}</div>
  </div>
  {example && <div class="step-view"><DocView example={example} phase={phase} /></div>}
</section>
<style>
  .doc-step { position: relative; padding-block: 64px; border-top: 1px solid var(--border); }
  .has-view { display: grid; grid-template-columns: minmax(0, 350px) minmax(0, 1fr); gap: 64px; align-items: center; min-height: 560px; }
  .step-copy, .step-view { min-width: 0; }
  .step-number { display: inline-flex; align-items: center; gap: 12px; margin-bottom: 20px; color: var(--identity-blue); font-size: 15px; font-weight: 550; font-variant-numeric: tabular-nums; }
  .step-number::after { content: ''; width: 42px; height: 1px; background: var(--border); }
  .step-copy :global(header > p) { margin-top: 18px; font-size: 17px; line-height: 1.5; }
  .step-copy :global(details) { margin-top: 24px; font-size: 15px; line-height: 1.65; }
  .step-copy :global(summary) { display: flex; align-items: center; gap: 8px; width: fit-content; padding-block: 8px; color: var(--ink-2); cursor: pointer; list-style: none; text-decoration: underline; text-decoration-color: var(--border); text-underline-offset: 5px; transition: color 160ms, text-decoration-color 160ms; }
  .step-copy :global(summary::-webkit-details-marker) { display: none; }
  .step-copy :global(summary > svg) { flex: none; transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1); }
  .step-copy :global(details[open] > summary > svg) { transform: rotate(90deg); }
  .step-copy :global(summary:hover) { color: var(--ink); text-decoration-color: currentColor; }
  .step-copy :global(summary:focus-visible) { outline: 2px solid var(--ring); outline-offset: 4px; border-radius: 3px; }
  .step-copy :global(details > * + *) { margin-top: 16px; }
  .doc-step:not(.has-view) .step-copy { max-width: 760px; }
  .reference .step-instructions { margin-top: 24px; overflow-x: auto; }
  .reference .step-copy :global(header > p) { max-width: 650px; }
  @media (max-width: 1000px) { .has-view { grid-template-columns: minmax(0, 300px) minmax(0, 1fr); gap: 32px; } }
  @media (max-width: 760px) { .doc-step { padding-block: 36px; } .has-view { display: flex; flex-direction: column; align-items: stretch; gap: 28px; min-height: 0; } .step-copy :global(header > p) { font-size: 16px; } }
  @media (prefers-reduced-motion: reduce) { .step-copy :global(summary), .step-copy :global(summary > svg) { transition: none; } }
</style>
