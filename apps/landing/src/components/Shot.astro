---
// A real capture of the app, in the reader's theme: light and dark variants of one page,
// in the page's language when it was captured in it, else in English. The captures are
// lossless WebP made by `just docs-media`; the site makes the smaller sizes from them.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n/strings';
import { pick, type Theme } from './variant';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*.webp', { eager: true });

interface Props {
  name: string;
  lang: Lang;
  alt: string;
  /** The width it is shown at on a wide screen, for the browser to pick a source. */
  sizes?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}
const { name, lang, alt, sizes = '(min-width: 1200px) 1100px, 100vw', class: className, loading = 'lazy' } = Astro.props;

const capture = (theme: Theme) => pick(name, lang, theme, (file) => files[`../assets/shots/${file}.webp`]?.default);

const widths = [720, 1440, 2160, 2880];
const srcset = async (src: ImageMetadata) => {
  const sets = await Promise.all(
    widths.filter((w) => w <= src.width).map(async (w) => {
      const image = await getImage({ src, width: w, format: 'webp', quality: 82 });
      return `${image.src} ${w}w`;
    }),
  );
  return sets.join(', ');
};
const light = capture('light');
const dark = capture('dark');
// The `<img>` itself is the light capture, for a browser that reads no `<source>`.
const fallback = await getImage({ src: light, width: Math.min(1440, light.width), format: 'webp', quality: 82 });
---

<picture class={className}>
  <source media="(prefers-color-scheme: dark)" srcset={await srcset(dark)} sizes={sizes} />
  <source srcset={await srcset(light)} sizes={sizes} />
  <img src={fallback.src} width={light.width} height={light.height} alt={alt} loading={loading} decoding="async" />
</picture>
