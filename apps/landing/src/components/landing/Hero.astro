---
import Icon from '../Icon.astro';
import HeroTitle from './HeroTitle.astro';
import StudyExample from '../StudyExample.astro';
import MacDesktopFrame from '../MacDesktopFrame.astro';
import { repo, t } from '#landing/i18n/strings.ts';
import type { Lang } from '#landing/i18n/strings.ts';

interface Props { lang: Lang }

const { lang } = Astro.props;

const s = t(lang);

const c = s.home;
---

<section class="hero frame" aria-labelledby="hero-title">
  <div class="hero-copy">
    <HeroTitle title={c.title} />
    <p class="hero-lead">{c.lead}</p>
    <div class="hero-actions"><a class="saas-primary" href="#download">{c.download}<Icon name="arrow-right" size={18} /></a><a class="saas-secondary" href={repo}>{c.source}<Icon name="arrow-right" size={16} /></a></div>
    <p class="hero-platforms">{c.platforms}</p>
  </div>
  <h2 class="visually-hidden">{c.featuresTitle}</h2>
  <div class="product-shot"><MacDesktopFrame lang={lang}><StudyExample lang={lang} kind="page" /></MacDesktopFrame></div>
</section>
