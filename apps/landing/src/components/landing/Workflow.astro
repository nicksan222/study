---
import Icon from '../Icon.astro';
import AppPreview from '../AppPreview.astro';
import { keyed, words } from './text';
import { href, t } from '#landing/i18n/strings.ts';
import type { Lang } from '#landing/i18n/strings.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const w = t(lang).workflow;

const icons = ['notebook-text', 'file-text', 'graduation-cap'];
---
<section class="workflow frame" id="workflow" aria-labelledby="workflow-title" data-ink-scope>
  <div class="workflow-heading">
    <h2 id="workflow-title" data-ink set:html={keyed(w.title, w.key, 'under', 81)} />
    <p>{w.lead}</p>
  </div>
  <div class="workflow-body">
    <ol class="journey">
      {w.steps.map((step, i) => <li>
        <span class:list={['journey-icon', 'chip', ['tint-blue', 'tint-green', 'tint-purple'][i]]}><Icon name={icons[i]} size={19} /></span>
        <div><h3>{step.title}</h3><p>{step.body}</p><a class="more" href={step.target.startsWith('#') ? step.target : href(lang, step.target)}>{step.link}<Icon name="arrow-right" size={14} /></a></div>
      </li>)}
    </ol>
    <div class="page-stage tint-blue" id="workflow-page">
      <AppPreview feature="page" lang={lang} label={t(lang).previewLabels.page} />
      <p class="hand page-note" data-ink><span data-type="hand" set:html={words(w.annotation)} /></p>
      <div class="page-outputs">{w.outputs.map((output, i) => <a href="#learn"><Icon name={['book-open', 'workflow', 'list-checks'][i]} size={15} />{output}<Icon name="arrow-right" size={13} /></a>)}</div>
      <p class="page-footer">{w.footer}</p>
    </div>
  </div>
</section>
<style>
  .workflow-heading { display: grid; grid-template-columns: 1fr 1fr; align-items: end; gap: var(--s-7); margin-bottom: var(--s-6); }
  h2 { font-size: clamp(32px, 4vw, 48px); line-height: 1.12; letter-spacing: -.035em; }
  .workflow-heading > p { max-width: 58ch; color: var(--ink-2); font-size: 17px; }
  .workflow-body { display: grid; grid-template-columns: 1fr 1.12fr; gap: clamp(40px, 7vw, 100px); align-items: center; }
  .journey { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s-5); }
  .journey li { position: relative; display: grid; grid-template-columns: 38px 1fr; gap: var(--s-4); }
  .journey li:not(:last-child)::after { content: ''; position: absolute; top: 46px; bottom: -14px; left: 18px; border-left: 1px dashed var(--line); }
  .journey-icon { width: 38px; height: 38px; border-radius: 10px; }
  .journey h3 { padding-top: 3px; font-size: 21px; letter-spacing: -.025em; line-height: 1.3; }
  .journey p { margin-top: var(--s-3); color: var(--ink-2); font-size: 16px; line-height: 1.65; max-width: 43ch; }
  .journey .more { margin-top: var(--s-3); font-size: 13px; }
  .page-stage { padding: var(--s-5); border-radius: var(--r-xl); background: var(--t-bg); }
  .page-note { text-align: right; font-size: 20px; margin-top: var(--s-3); rotate: -2deg; }
  .page-outputs { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-2); margin-top: var(--s-5); }
  .page-outputs a { display: inline-flex; align-items: center; gap: 6px; padding: 7px 10px; border: 1px solid color-mix(in oklab, var(--t-ink) 20%, transparent); border-radius: var(--r-md); font-size: 12px; text-decoration: none; color: var(--t-ink); }
  .page-outputs a:hover { background: var(--t-chip); }
  .page-footer { margin-top: var(--s-4); text-align: center; color: var(--t-ink); font-size: 12px; }
  @media(max-width: 800px) { .workflow-heading { grid-template-columns: 1fr; gap: var(--s-4); } .workflow-body { grid-template-columns: 1fr; gap: var(--s-5); } .journey { gap: var(--s-6); } .journey p { max-width: 65ch; } }
  @media(max-width: 480px) { .page-stage { padding: var(--s-4); } .workflow-heading { margin-bottom: var(--s-6); } }
</style>
