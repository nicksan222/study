---
import Icon from '../Icon.astro';
import { downloadUrl, href, platforms, releases, repo, t } from '#landing/i18n/strings.ts';
import type { Lang } from '#landing/i18n/strings.ts';

interface Props {
  lang: Lang;
  presentation?: 'section' | 'guide';
}

const { lang, presentation = 'section' } = Astro.props;

const s = t(lang);
---

<section
  class:list={['downloads', 'frame', { 'downloads-guide': presentation === 'guide' }]}
  id="download"
  aria-labelledby="download-title"
>
  <div class="download-heading">
    <h2 id="download-title">{s.home.downloadTitle}</h2>
    <p>{s.home.downloadLead}</p>
  </div>
  <div class="download-body">
    <div class="download-list">
      {platforms.map((platform) => (
        <a href={downloadUrl(platform.file)} aria-label={s.get.rows[platform.os].label}>
          <span>{s.get.rows[platform.os].name}</span>
          <Icon name="arrow-right" size={20} />
        </a>
      ))}
    </div>
    <div class="download-details">
      <p>{s.get.linuxNote}</p>
      <div>
        <a href={href(lang, 'docs/install/')}>{s.get.install}</a>
        <a href={releases}>{s.get.all}</a>
      </div>
    </div>
    <p class="release-note">{s.get.early} <a href={`${repo}/issues`}>{s.get.tellUs}</a>.</p>
  </div>
</section>
