---
import { repo, t } from '#landing/i18n/strings.ts';
import type { Lang } from '#landing/i18n/strings.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const c = t(lang).home;
---

<section class="ownership frame" id="yours" aria-labelledby="ownership-title">
  <h2 id="ownership-title">{c.ownershipTitle[0]}<br /><span>{c.ownershipTitle[1]}</span></h2>
  <div class="ownership-copy">
    <p class="ownership-lead">{c.ownershipLead}</p>
    <dl class="ownership-details">
      <div>
        <dt>{c.aiTitle}</dt>
        <dd>{c.aiBody}</dd>
      </div>
      <div>
        <dt>{c.openTitle}</dt>
        <dd>{c.openBody} <a href={repo}>{c.source}</a></dd>
      </div>
    </dl>
  </div>
</section>
