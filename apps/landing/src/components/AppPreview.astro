---
import type { PreviewFeature } from '@study/client/feature-previews';
import type { Lang } from '#landing/i18n/strings.ts';

interface Props {
  feature: PreviewFeature;
  lang: Lang;
  label: string;
  caption?: string;
}

const { feature, lang, label, caption } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<figure class="app-preview" data-app-preview={feature}>
  <div class="app-preview-image" role="img" aria-label={label}>
    <iframe
      src={`${base}/previews/${lang}/${feature}/`}
      title={label}
      loading="lazy"
      tabindex="-1"
      aria-hidden="true"
      inert
    />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  for (const frame of document.querySelectorAll<HTMLIFrameElement>('[data-app-preview] iframe')) {
    const fit = () => {
      const content = frame.contentDocument?.querySelector('main');

      if (!content) return;

      const resize = () => {
        frame.style.height = `${Math.ceil(content.getBoundingClientRect().height)}px`;
      };

      resize();
      new ResizeObserver(resize).observe(content);
    };

    frame.addEventListener('load', fit);

    if (frame.contentDocument?.readyState === 'complete') fit();
  }
</script>

<style>
  .app-preview { margin: 0; width: 100%; min-width: 0; }
  .app-preview-image { overflow: hidden; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--canvas); }
  iframe { display: block; border: 0; width: 100%; height: 350px; pointer-events: none; }
  [data-app-preview='quiz'] iframe { height: 440px; }
  [data-app-preview='flashcards'] iframe { height: 300px; }
  figcaption { margin-top: var(--s-3); color: var(--ink-3); font-size: 13px; line-height: 1.45; text-align: center; }
</style>
