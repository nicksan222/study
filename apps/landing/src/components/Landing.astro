---
// Static product overview, ownership details and direct platform downloads.
import Base from '../layouts/Base.astro';
import SiteNav from './SiteNav.astro';
import Hero from './landing/Hero.astro';
import Yours from './landing/Yours.astro';
import Capabilities from './landing/Capabilities.astro';
import Download from './landing/Download.astro';
import { t } from '../i18n/strings';
import type { Lang } from '../i18n/strings';
import '../styles/landing.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const s = t(lang);

---

<Base lang={lang} title={s.meta.title} description={s.meta.description} path="" immersive>
<SiteNav lang={lang} />
  <main id="main" class="landing" tabindex="-1">
    <Hero lang={lang} />
    <Capabilities lang={lang} />
    <Yours lang={lang} />
    <Download lang={lang} />
  </main>
</Base>
