---
import Base from './Base.astro';
import SiteNav from '../components/SiteNav.astro';
import DocsMenu from '../components/DocsMenu.astro';
import DocsArticle from '../components/DocsArticle.astro';
import DocsIndex from '../components/DocsIndex.astro';
import '../styles/landing.css';
import '../styles/docs.css';
import { docsIn, slug } from '../i18n/docs';
import type { Doc } from '../i18n/docs';
import { t } from '../i18n/strings';
import type { Lang } from '../i18n/strings';

interface Props { lang: Lang; doc?: Doc; headings?: { depth: number; slug: string; text: string }[]; }

const { lang, doc, headings = [] } = Astro.props;

const s = t(lang);

const all = await docsIn(lang);

const current = doc ? slug(doc) : undefined;

const at = all.findIndex((d) => slug(d) === current);

const previous = all.at(at - 1);

const next = all.at(at + 1);

const path = doc ? `docs/${current}/` : 'docs/';

const title = `${doc ? `${doc.data.title} · ` : ''}${s.docs.title} · Study`;

const description = doc?.data.description ?? s.docs.lead;
---
<Base lang={lang} title={title} description={description} path={path} immersive>
  <SiteNav lang={lang} path={path} />
  <div class="docs frame">
    <DocsMenu lang={lang} all={all} current={current} />
    <main id="main" class="page" tabindex="-1">
      {doc ? <DocsArticle lang={lang} doc={doc} headings={headings} previous={at > 0 ? previous : undefined} next={next}><slot /></DocsArticle> : <DocsIndex lang={lang} all={all} />}
    </main>
  </div>
</Base>
