---
import { render } from 'astro:content';
import Media from '#landing/components/Media.astro';
import Docs from '#landing/layouts/Docs.astro';
import { docsIn, slug } from '#landing/i18n/docs.ts';

export async function getStaticPaths() {
  const docs = await docsIn('it');

  return docs.map((doc) => ({ params: { slug: slug(doc) }, props: { doc } }));
}

const { doc } = Astro.props;

const { Content } = await render(doc);
---

<Docs lang="it" doc={doc}>
  <Content components={{ img: Media }} />
</Docs>
