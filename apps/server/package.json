{
  "name": "@study/server",
  "private": true,
  "type": "module",
  "imports": {
    "#server/*": "./src/*.ts",
    "#testing/*": "./test/testing/*.ts",
    "#integration-tests/*": "./test/integrations/*.ts"
  },
  "exports": {
    "./client": "./src/client/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./runtime/ownership": "./src/runtime/ownership.ts"
  },
  "scripts": {
    "test": "bun --bun vp test run --config ../../vite.config.ts --project server apps/server",
    "start": "bun src/runtime/main.ts",
    "typecheck": "bun --bun tsc --noEmit -p ../../tooling/typescript/server.json",
    "integrations": "bun --bun vp test run --config test/integrations/vite.config.ts integrations.e2e.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.135",
    "@ai-sdk/google": "3.0.139",
    "@ai-sdk/openai": "3.0.132",
    "@ai-sdk/openai-compatible": "2.0.87",
    "@ai-sdk/provider": "3.0.19",
    "@effect/platform-bun": "4.0.7",
    "@study/contracts": "*",
    "@study/db": "*",
    "@study/integrations": "*",
    "@study/localization": "*",
    "@study/theme": "*",
    "ai": "6.0.316",
    "cheerio": "1.2.0",
    "effect": "4.0.7",
    "fast-xml-parser": "5.11.2",
    "pdf-lib": "1.17.1",
    "ts-fsrs": "5.4.2",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@study/testing": "*",
    "@types/yauzl": "3.4.0",
    "testcontainers": "12.2.1"
  }
}
