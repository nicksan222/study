{
  "name": "@study/server",
  "private": true,
  "type": "module",
  "imports": {
    "#server/*": "./src/*.ts",
    "#testing/*": "./test/testing/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./node": "./src/client/node.ts",
    "./runtime": "./src/runtime/index.ts",
    "./shared/ids": "./src/shared/ids.ts",
    "./shared/json": "./src/shared/json.ts",
    "./shared/errors": "./src/shared/errors/index.ts",
    "./shared/projects": "./src/shared/projects/index.ts",
    "./shared/sources": "./src/shared/sources/index.ts",
    "./shared/conversations": "./src/shared/conversations/index.ts",
    "./shared/jobs": "./src/shared/jobs/index.ts",
    "./shared/study": "./src/shared/study/index.ts",
    "./shared/search": "./src/shared/search/index.ts",
    "./shared/settings": "./src/shared/settings/index.ts",
    "./shared/materials": "./src/shared/materials/index.ts",
    "./shared/learning": "./src/shared/learning/index.ts"
  },
  "scripts": {
    "test": "node --import ./test/testing/preload.ts --test 'test/**/*.test.ts' 'src/procedures/**/*.test.ts'",
    "start": "node src/runtime/main.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "3.0.19",
    "@study/ai": "*",
    "@study/db": "*",
    "@study/localization": "*",
    "@study/theme": "*",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "ai": "6.0.316",
    "cheerio": "1.2.0",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.0.7",
    "eventsource": "5.1.3",
    "fast-xml-parser": "5.11.2",
    "pdf-lib": "1.17.1",
    "superjson": "2.2.6",
    "ts-fsrs": "5.4.2",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/yauzl": "3.4.0"
  }
}
