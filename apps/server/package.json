{
  "name": "@study/server",
  "private": true,
  "type": "module",
  "imports": {
    "#server/*": "./src/*.ts",
    "#testing/*": "./test/testing/*.ts"
  },
  "exports": {
    ".": "./src/platform/index.ts",
    "./client": "./src/client/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./runtime/ownership": "./src/runtime/ownership.ts",
    "./runtime/database": "./src/runtime/database.ts",
    "./testing": "./test/testing/fixture.ts"
  },
  "scripts": {
    "test": "bun --bun vp test run --config ../../vite.config.ts --project server apps/server",
    "start": "bun src/runtime/main.ts",
    "typecheck": "bun --bun tsc --noEmit -p ../../tooling/typescript/server.json",
    "integrations": "bun ../../tooling/testing/integrations/run.ts"
  },
  "dependencies": {
    "@effect/ai-anthropic": "4.0.7",
    "@effect/ai-openai": "4.0.7",
    "@effect/ai-openai-compat": "4.0.7",
    "@effect/platform-bun": "4.0.7",
    "@effect/sql-sqlite-bun": "4.0.7",
    "@study/contracts": "*",
    "@study/db": "*",
    "@study/integrations": "*",
    "@study/localization": "*",
    "@study/theme": "*",
    "cheerio": "1.2.0",
    "effect": "4.0.7",
    "fast-xml-parser": "5.11.2",
    "pdf-lib": "1.17.1",
    "ts-fsrs": "5.4.2",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@study/testing": "*",
    "@types/yauzl": "3.4.0",
    "fast-check": "4.10.2"
  },
  "optionalDependencies": {
    "@transcribe-cpp/darwin-arm64-metal": "0.4.2",
    "@transcribe-cpp/darwin-x64-cpu": "0.4.2",
    "@transcribe-cpp/linux-arm64-cpu-vulkan": "0.4.2",
    "@transcribe-cpp/linux-x64-cpu-vulkan": "0.4.2",
    "@transcribe-cpp/win32-x64-cpu-vulkan": "0.4.2"
  }
}
