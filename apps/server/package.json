{
  "name": "@study/server",
  "private": true,
  "type": "module",
  "imports": {
    "#server/*": "./src/*.ts",
    "#testing/*": "./test/testing/*.ts"
  },
  "exports": {
    "./client": "./src/client/index.ts",
    "./runtime": "./src/runtime/index.ts"
  },
  "scripts": {
    "test": "node --import ./test/testing/preload.ts --test 'test/**/*.test.ts' 'src/**/*.test.ts'",
    "start": "node src/runtime/main.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.132",
    "@ai-sdk/provider": "3.0.19",
    "@effect/platform-node": "4.0.7",
    "@study/contracts": "*",
    "@study/db": "*",
    "@study/localization": "*",
    "@study/theme": "*",
    "ai": "6.0.316",
    "cheerio": "1.2.0",
    "effect": "4.0.7",
    "fast-xml-parser": "5.11.2",
    "jsdom": "30.1.3",
    "mermaid": "12.2.0",
    "pdf-lib": "1.17.1",
    "ts-fsrs": "5.4.2",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/yauzl": "3.4.0"
  }
}
