{
  "name": "study-workspace",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/desktop",
    "apps/server",
    "packages/*",
    "tooling"
  ],
  "type": "module",
  "scripts": {
    "build": "vp run typecheck && vp run --fail-if-no-match --filter @study/web build",
    "typecheck": "vp exec tsc --noEmit -p tooling/typescript/tooling.json && vp run --fail-if-no-match --filter @study/web typecheck",
    "server:typecheck": "vp exec tsc --noEmit -p tooling/typescript/server.json",
    "server:test": "vp test run --project server",
    "lint": "bun tooling/oxc-config/check-theme-css.ts && npm run architecture:check && vp check --deny-warnings",
    "quality:test": "vp test run --project tooling",
    "web:e2e": "vp test run --project web-e2e",
    "test": "vp run --fail-if-no-match --filter @study/web test",
    "gen": "bun tooling/development/generate-theme-css.ts && bun run --filter @study/db gen && bun run --filter @study/web gen:routes",
    "gen:check": "bun tooling/development/generate-theme-css.ts --check && bun run --filter @study/db gen:check",
    "desktop:dev": "vp run --fail-if-no-match --filter @study/desktop tauri dev",
    "desktop:build": "vp run --fail-if-no-match --filter @study/desktop tauri build",
    "desktop:runtime": "bun tooling/release/prepare-runtime.ts",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "gen:routes": "vp run --fail-if-no-match --filter @study/web gen:routes",
    "dev": "bun --watch --no-clear-screen tooling/development/dev.ts",
    "architecture:check": "bun tooling/oxc-config/check-architecture.ts",
    "fallow:check": "fallow --config tooling/fallow.jsonc --fail-on-issues",
    "seed": "bun tooling/seed/index.ts",
    "integrations:e2e": "bun test --timeout 180000 ./apps/server/test/integrations/integrations.e2e.ts"
  },
  "devDependencies": {
    "@study/testing": "*",
    "@study/tooling": "*",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fallow": "3.38.0",
    "jsdom": "^30.1.3",
    "playwright": "1.65.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.7",
    "effect": "4.0.7",
    "vite": "$vite",
    "vitest": "5.0.5"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
