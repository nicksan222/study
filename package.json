{
  "name": "study-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings apps/desktop/src packages/ui/src && node tooling/codegen/ui-copy.mjs",
    "test": "vitest run && node --test tooling/codegen/*.test.mjs",
    "check:protocol": "node tooling/codegen/generate.mjs --check",
    "gen:protocol": "node tooling/codegen/generate.mjs",
    "desktop:dev": "cd apps/desktop && tauri dev",
    "desktop:build": "cd apps/desktop && tauri build",
    "format": "prettier --write apps/desktop/src packages/ui/src tooling/codegen vite.config.ts tsconfig.json",
    "format:check": "prettier --check apps/desktop/src packages/ui/src tooling/codegen vite.config.ts tsconfig.json"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.8",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
