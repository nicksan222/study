{
  "name": "study-workspace",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/desktop",
    "apps/server",
    "packages/*",
    "tooling"
  ],
  "type": "module",
  "scripts": {
    "build": "TURBO_TELEMETRY_DISABLED=1 bun --bun turbo run build --concurrency=1",
    "typecheck": "TURBO_TELEMETRY_DISABLED=1 bun --bun turbo run typecheck --concurrency=1",
    "server:typecheck": "TURBO_TELEMETRY_DISABLED=1 bun --bun turbo run typecheck --filter=@study/server --concurrency=1",
    "server:test": "TURBO_TELEMETRY_DISABLED=1 bun --bun turbo run test --filter=@study/server... --filter=!@study/tooling --concurrency=1",
    "lint": "TURBO_TELEMETRY_DISABLED=1 bun --bun turbo run lint:repo",
    "quality:test": "TURBO_TELEMETRY_DISABLED=1 bun --bun turbo run test --filter=@study/tooling --filter=@study/testing --concurrency=1",
    "test": "TURBO_TELEMETRY_DISABLED=1 bun --bun turbo run test --concurrency=1",
    "web:e2e": "TURBO_TELEMETRY_DISABLED=1 bun --bun turbo run e2e --filter=@study/web --concurrency=1",
    "gen": "bun tooling/scripts/development/generate-theme-css.ts && bun run --filter @study/db gen && bun run --filter @study/web gen:routes",
    "gen:check": "bun run gen:theme:check && TURBO_TELEMETRY_DISABLED=1 bun --bun turbo run gen:check --filter=@study/db",
    "desktop:dev": "bun --bun vp run --fail-if-no-match --filter @study/desktop tauri dev",
    "desktop:build": "bun --bun vp run --fail-if-no-match --filter @study/desktop tauri build",
    "desktop:runtime": "bun tooling/scripts/release/prepare-runtime.ts",
    "format": "bun --bun vp fmt",
    "format:check": "bun --bun vp fmt --check",
    "gen:routes": "bun --bun vp run --fail-if-no-match --filter @study/web gen:routes",
    "dev": "bun --watch --no-clear-screen tooling/scripts/development/dev.ts",
    "architecture:check": "bun tooling/oxc-config/check-architecture.ts",
    "fallow:check": "TURBO_TELEMETRY_DISABLED=1 bun --bun turbo run fallow:repo",
    "seed": "bun tooling/scripts/seed/index.ts",
    "integrations:e2e": "bun --bun vp test run --config apps/server/test/integrations/vite.config.ts integrations.e2e.ts",
    "web:e2e:compare": "bun --bun vp test run --project web-e2e",
    "web:e2e:update": "bun apps/web/test/e2e/harness/update.ts",
    "web:e2e:capacity": "bun apps/web/test/e2e/harness/capacity.ts",
    "check:changed": "TURBO_TELEMETRY_DISABLED=1 bun --bun turbo run check --affected --concurrency=1 --continue=always",
    "check:global": "bun run check-shell && bun run lint && bun run fallow:check && bun run gen:theme:check",
    "test:web": "TURBO_TELEMETRY_DISABLED=1 bun --bun turbo run test --filter=@study/web --filter=@study/ui --filter=@study/localization --concurrency=1",
    "check": "TURBO_TELEMETRY_DISABLED=1 bun --bun turbo run check --concurrency=1 --continue=always",
    "check:landing": "bun install --cwd apps/landing --frozen-lockfile && bun run --cwd apps/landing check && bun run --cwd apps/landing build",
    "desktop": "bash tooling/scripts/desktop/restart.sh",
    "desktop-window": "bash tooling/scripts/desktop/window.sh",
    "desktop-shot": "bash tooling/scripts/desktop/shot.sh",
    "desktop-click": "bash tooling/scripts/desktop/click.sh",
    "desktop-record": "bash tooling/scripts/desktop/record.sh",
    "desktop-query": "bash tooling/scripts/desktop/query.sh",
    "desktop-status": "bash tooling/scripts/desktop/status.sh",
    "desktop-wait": "bash tooling/scripts/desktop/wait.sh",
    "run": "bash tooling/scripts/desktop/run.sh",
    "desktop-screen": "bash tooling/scripts/desktop/screen.sh",
    "desktop-watch": "python3 tooling/scripts/desktop/watch.py",
    "desktop-run": "bash tooling/scripts/desktop/app.sh",
    "desktop-attach": "bash tooling/scripts/desktop/attach.sh",
    "desktop-browser": "bash tooling/scripts/desktop/browser.sh",
    "desktop-stop": "bash tooling/scripts/desktop/stop.sh",
    "doctor": "bash tooling/scripts/development/doctor.sh",
    "release": "bash tooling/scripts/release/release.sh",
    "package": "bash tooling/scripts/release/release.sh build",
    "landing": "bun run --cwd apps/landing dev --host",
    "landing-build": "bun install --cwd apps/landing --frozen-lockfile && bun run --cwd apps/landing build",
    "landing-check": "bun run check:landing",
    "check-shell": "shellcheck -x tooling/scripts/development/*.sh tooling/scripts/release/*.sh tooling/scripts/devcontainer/*.sh tooling/scripts/desktop/*.sh",
    "gen-check": "bun run gen:check",
    "tooling-test": "bun run quality:test",
    "frontend-check": "bun run typecheck && bun run test:web && bun run web:e2e",
    "server-check": "bun run server:typecheck && bun run server:test",
    "fallow-check": "bun run fallow:check",
    "docs": "TURBO_TELEMETRY_DISABLED=1 bun --bun turbo run docs --filter=@study/desktop",
    "deny": "TURBO_TELEMETRY_DISABLED=1 bun --bun turbo run deny --filter=@study/desktop",
    "native:test": "TURBO_TELEMETRY_DISABLED=1 bun --bun turbo run test --filter=@study/desktop",
    "native:lint": "TURBO_TELEMETRY_DISABLED=1 bun --bun turbo run lint --filter=@study/desktop",
    "native:fmt": "TURBO_TELEMETRY_DISABLED=1 bun --bun turbo run fmt:check --filter=@study/desktop",
    "agents": "python3 tooling/scripts/agents/agents.py up",
    "agents-stop": "python3 tooling/scripts/agents/agents.py down",
    "agents-reset": "python3 tooling/scripts/agents/agents.py reset",
    "agents-doctor": "python3 tooling/scripts/agents/agents.py doctor",
    "agents-usage": "python3 tooling/scripts/agents/usage.py",
    "agent": "python3 tooling/scripts/agents/agents.py up",
    "check-crate": "bash tooling/scripts/development/check-crate.sh",
    "lint:repo": "bun tooling/oxc-config/check-theme-css.ts && bun run architecture:check && bun --bun vp check --deny-warnings",
    "fallow:repo": "bun --bun fallow --config tooling/fallow.jsonc --fail-on-issues",
    "gen:theme:check": "bun tooling/scripts/development/generate-theme-css.ts --check"
  },
  "devDependencies": {
    "@study/testing": "*",
    "@study/tooling": "*",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "1.3.13",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fallow": "3.38.0",
    "jsdom": "^30.1.3",
    "pixelmatch": "7.1.0",
    "playwright": "1.65.0",
    "pngjs": "7.0.0",
    "turbo": "2.11.11",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "effect": "4.0.7",
    "vite": "$vite",
    "vitest": "5.0.5"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
