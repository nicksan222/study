{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["bun"]
  },
  "include": [
    "../../packages/*/src/**/*.ts",
    "../../packages/*/test/**/*.ts",
    "../../apps/server/src/**/*.ts",
    "../../apps/server/test/**/*.ts"
  ],
  "exclude": [
    "../../packages/ui",
    "../../packages/testing/src/bun.ts",
    "../../apps/server/test/process-recovery.bun.test.ts"
  ]
}
