{
  "$schema": "../node_modules/fallow/schema.json",
  "minimumVersion": "3.38.0",
  "workspaces": {
    "patterns": ["apps/landing"]
  },
  // Build output and generated framework wiring are not authored source.
  "ignorePatterns": [
    "target/**",
    // Source fixtures are imported as bytes, never executed as tooling modules.
    "tooling/scripts/seed/fixtures/files/**",
    "graphify-out/**",
    "apps/client/src/routeTree.gen.ts",
    "apps/desktop/src-tauri/gen/**"
  ],
  // Private workspace exports must have a real consumer.
  "includeEntryExports": true,
  "failOnParseError": true,
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "unused-enum-members": "error",
    "unused-class-members": "error",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "re-export-cycle": "error",
    "package-cycle": "error",
    "boundary-violation": "error",
    "stale-suppressions": "error",
    "require-suppression-reason": "error"
  },
  // Complexity ceilings fail the gate; unit size is an advisory report.
  // CRAP needs measured coverage, so its estimate does not gate this repository.
  "health": {
    "maxCyclomatic": 10,
    "maxCognitive": 15,
    "maxUnitSize": 60,
    "maxCrap": 0
  },
  // --fail-on-issues rejects every clone group; threshold: 0 alone would not.
  "duplicates": {
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    "minOccurrences": 2,
    // The 51-token open-answer join belongs to two independent feature stores.
    // Sharing it would expose a private store or move domain queries into @study/db.
    // This exact content/count exception expires if either query or copy count changes.
    "ignoredClones": ["dup:328fd34f:2"]
  },
  "boundaries": {
    "zones": [
      {
        "name": "tests",
        // Public fixture facets are test code; Oxlint prohibits production imports.
        "patterns": [
          "**/*.test.*",
          "**/test/**",
          "**/tests/**",
          "packages/testing/**",
          "packages/db/src/testing.ts",
          "packages/contracts/src/testing.ts",
          "packages/contracts/src/react-testing.ts",
          "apps/mobile/src/testing.ts",
          "apps/desktop/src/testing.ts"
        ]
      },
      {
        "name": "contracts",
        "patterns": ["packages/contracts/src/**"]
      },
      {
        "name": "integrations",
        "patterns": ["packages/integrations/src/**"]
      },
      {
        "name": "theme",
        "patterns": ["packages/theme/src/**"]
      },
      {
        "name": "localization",
        "patterns": ["packages/localization/src/**"]
      },
      {
        "name": "icons",
        "patterns": ["packages/icons/src/**"]
      },
      {
        "name": "ui",
        "patterns": ["packages/ui/src/**"]
      },
      {
        "name": "db",
        "patterns": ["packages/db/src/**"]
      },
      {
        "name": "server-client",
        "patterns": ["apps/server/src/client/**"]
      },
      {
        "name": "server-platform",
        "patterns": ["apps/server/src/platform/**"]
      },
      {
        "name": "server-features",
        "patterns": ["apps/server/src/features/**"]
      },
      {
        "name": "server-runtime",
        "patterns": ["apps/server/src/runtime/**"]
      },
      {
        "name": "client-previews",
        "patterns": ["apps/client/src/feature-previews/**"]
      },
      {
        "name": "client",
        "patterns": ["apps/client/src/**", "apps/client/index.html"]
      },
      {
        "name": "client-hosts",
        "patterns": ["apps/{mobile,desktop}/src/**", "apps/{mobile,desktop}/index.html"]
      },
      {
        "name": "landing",
        "patterns": ["apps/landing/src/**"]
      },
      {
        "name": "tooling",
        "patterns": [
          "tooling/**",
          "**/*.config.*",
          "apps/desktop/src-tauri/**",
          "apps/client/tsr.config.json",
          "apps/client/*.ts",
          "apps/mobile/prepare.ts",
          "apps/landing/*.ts",
          "apps/landing/scripts/**"
        ]
      }
    ],
    "rules": [
      {
        "from": "contracts",
        "allow": []
      },
      {
        "from": "integrations",
        "allow": ["contracts"]
      },
      {
        "from": "theme",
        "allow": ["contracts"]
      },
      {
        "from": "localization",
        "allow": []
      },
      {
        "from": "icons",
        "allow": []
      },
      {
        "from": "ui",
        "allow": ["theme", "icons"]
      },
      {
        "from": "db",
        "allow": ["contracts", "theme"]
      },
      {
        "from": "server-client",
        "allow": ["contracts"]
      },
      {
        "from": "server-platform",
        "allow": ["contracts", "db", "localization", "theme"]
      },
      {
        "from": "server-features",
        "allow": ["server-platform", "contracts", "db", "localization", "theme", "integrations"]
      },
      {
        "from": "server-runtime",
        "allow": [
          "server-platform",
          "server-features",
          "server-client",
          "contracts",
          "db",
          "localization",
          "theme"
        ]
      },
      {
        "from": "client-previews",
        "allow": ["client", "contracts", "ui", "icons", "localization", "theme"]
      },
      {
        "from": "client",
        "allow": ["server-client", "contracts", "ui", "icons", "localization", "theme"]
      },
      {
        "from": "client-hosts",
        "allow": ["client", "contracts", "ui", "icons", "localization"]
      },
      {
        "from": "landing",
        "allow": ["theme", "localization", "ui", "icons", "contracts", "client-previews"]
      },
      {
        "from": "tests",
        "allow": [
          "tests",
          "contracts",
          "integrations",
          "theme",
          "localization",
          "ui",
          "icons",
          "db",
          "server-client",
          "server-platform",
          "server-features",
          "server-runtime",
          "client",
          "client-previews",
          "client-hosts",
          "landing",
          "tooling"
        ]
      },
      {
        "from": "tooling",
        "allow": [
          "tests",
          "contracts",
          "theme",
          "localization",
          "ui",
          "icons",
          "db",
          "server-client",
          "server-platform",
          "server-features",
          "server-runtime",
          "client",
          "client-previews",
          "client-hosts",
          "landing",
          "tooling"
        ]
      }
    ],
    "coverage": {
      "requireAllFiles": true
    }
  },
  // Astro's native compiler consumes this pinned transitive runtime without a source import.
  "ignoreDependencies": ["@emnapi/runtime"],
  "entry": [
    // Each host HTML selects its own React bootstrap.
    "apps/mobile/src/main.tsx",
    "apps/desktop/src/main.tsx",
    "apps/client/src/main.tsx",
    "packages/localization/test/api.types.ts",
    "packages/testing/test/api.types.ts",
    "packages/testing/test/vitest.types.ts",
    // Compile-only fixture boundaries are checked by their environment-specific tsconfigs.
    "apps/server/test/testing/scenarios.types.ts",
    "apps/client/test/e2e/harness/fixtures.types.ts",
    "apps/server/test/testing/automatic-fixture-scenario.ts",
    "tooling/testing/integrations/run.ts",
    // Explicit opt-in real speech integration runner; models are supplied by the caller.
    "tooling/testing/voice/native.integration.ts"
  ],
  // Oxlint loads this plugin from the specifier in tooling/oxc-config/lint.ts.
  "framework": [
    {
      "name": "study-oxlint",
      "enablers": ["vite-plus"],
      "toolingDependencies": ["@stylistic/eslint-plugin"],
      // Test runners consume these default exports as fixture configuration and global setup.
      "configPatterns": [
        "apps/mobile/vite.config.ts",
        "apps/desktop/vite.config.ts",
        "apps/client/playwright.config.ts",
        "apps/server/test/testing/automatic-fixture.config.ts",
        "apps/client/test/e2e/harness/preflight.ts"
      ]
    }
  ]
}
