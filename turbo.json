{
  "$schema": "https://turborepo.dev/schema.json",
  "cacheDir": ".turbo/cache",
  "globalDependencies": [
    "*",
    ".cargo/**",
    ".github/**",
    ".devcontainer/**",
    ".agents/**",
    "tooling/**",
    "packages/testing/src/**",
    "apps/landing/**",
    "!**/.turbo/**",
    "!**/node_modules/**",
    "!**/dist/**",
    "!**/.astro/**",
    "!**/.tanstack/**",
    "!**/test-results/**"
  ],
  "globalEnv": ["CI", "NODE_ENV", "STUDY_*", "VITE_*", "CARGO_*", "RUST*", "BUN_*"],
  "tasks": {
    "check": {
      "dependsOn": ["test", "typecheck", "//#check:global", "//#check:landing"],
      "cache": false
    },
    "//#check:global": {
      "dependsOn": ["//#check-shell", "//#lint:repo", "//#fallow:repo", "//#gen:theme:check"],
      "cache": false,
      "inputs": ["package.json", "tooling/oxc-config/**", "tooling/fallow.jsonc"]
    },
    "//#check:landing": {
      "cache": false,
      "inputs": [
        "apps/landing/src/**",
        "apps/landing/public/**",
        "apps/landing/*.json",
        "apps/landing/*.mjs",
        "apps/landing/bun.lock"
      ],
      "envMode": "loose"
    },
    "test": {
      "cache": false,
      "envMode": "loose"
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "@study/client#check": {
      "dependsOn": ["test", "typecheck", "e2e", "//#check:global", "//#check:landing"],
      "cache": false
    },
    "@study/server#check": {
      "dependsOn": ["test", "typecheck", "integrations", "//#check:global", "//#check:landing"],
      "cache": false
    },
    "@study/desktop#check": {
      "dependsOn": [
        "//#check:global",
        "//#check:landing",
        "//#runtime:smoke",
        "fmt:check",
        "lint",
        "deny",
        "test",
        "docs"
      ],
      "cache": false,
      "envMode": "loose"
    },
    "@study/db#check": {
      "dependsOn": ["test", "gen:check", "typecheck", "//#check:global", "//#check:landing"],
      "cache": false
    },
    "@study/server#typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/tooling/typescript/**",
        "!$TURBO_ROOT$/packages/**/.turbo/**"
      ]
    },
    "@study/client#typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!src/routeTree.gen.ts",
        "$TURBO_ROOT$/packages/**",
        "!$TURBO_ROOT$/packages/**/.turbo/**"
      ],
      "outputs": ["src/routeTree.gen.ts"]
    },
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**"]
    },
    "@study/client#build": {
      "dependsOn": ["^build", "typecheck", "@study/tooling#typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!src/routeTree.gen.ts"],
      "outputs": ["dist/**"]
    },
    "e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "envMode": "loose"
    },
    "integrations": {
      "cache": false,
      "envMode": "loose"
    },
    "gen:check": {
      "cache": false,
      "envMode": "loose"
    },
    "@study/contracts#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/server/test/testing/**",
        "$TURBO_ROOT$/packages/db/**",
        "!$TURBO_ROOT$/packages/db/.turbo/**"
      ],
      "cache": true,
      "envMode": "strict",
      "outputs": ["test-results/vitest/**"]
    },
    "@study/localization#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/server/test/testing/**",
        "$TURBO_ROOT$/packages/db/**",
        "!$TURBO_ROOT$/packages/db/.turbo/**"
      ],
      "cache": true,
      "envMode": "strict",
      "outputs": ["test-results/vitest/**"]
    },
    "@study/theme#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/server/test/testing/**",
        "$TURBO_ROOT$/packages/db/**",
        "!$TURBO_ROOT$/packages/db/.turbo/**"
      ],
      "cache": true,
      "envMode": "strict",
      "outputs": ["test-results/vitest/**"]
    },
    "@study/ui#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/client/vite.config.ts",
        "$TURBO_ROOT$/apps/client/src/test/**",
        "$TURBO_ROOT$/tooling/scripts/development/rpc-proxy.ts"
      ],
      "cache": true,
      "envMode": "strict",
      "outputs": ["test-results/vitest/**"]
    },
    "@study/testing#test": {
      "dependsOn": ["^typecheck"],
      "cache": true,
      "envMode": "strict",
      "outputs": ["test-results/vitest/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/client/vite.config.ts",
        "$TURBO_ROOT$/apps/client/src/test/**"
      ]
    },
    "@study/client#test": {
      "dependsOn": ["^typecheck"],
      "cache": true,
      "envMode": "strict",
      "outputs": ["test-results/vitest/**"]
    },
    "@study/tooling#typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/client/vite.config.ts",
        "$TURBO_ROOT$/apps/client/test/e2e/**",
        "$TURBO_ROOT$/packages/testing/**"
      ]
    },
    "@study/tooling#test": {
      "cache": false,
      "envMode": "loose",
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/desktop/src-tauri/src/**",
        "$TURBO_ROOT$/apps/desktop/src-tauri/permissions/**",
        "$TURBO_ROOT$/apps/desktop/src-tauri/capabilities/**",
        "$TURBO_ROOT$/apps/desktop/src-tauri/tests/**"
      ]
    },
    "fmt:check": {
      "cache": false,
      "envMode": "loose"
    },
    "lint": {
      "cache": false,
      "envMode": "loose"
    },
    "deny": {
      "cache": false,
      "envMode": "loose"
    },
    "docs": {
      "cache": false,
      "envMode": "loose"
    },
    "//#lint:repo": {
      "inputs": ["package.json", "vite.config.ts", "tooling/oxc-config/**", "tooling/fallow.jsonc"],
      "cache": false
    },
    "//#fallow:repo": {
      "inputs": ["package.json", "vite.config.ts", "tooling/oxc-config/**", "tooling/fallow.jsonc"],
      "cache": false
    },
    "//#check-shell": {
      "inputs": ["tooling/scripts/**/*.sh"],
      "cache": false
    },
    "//#check:native": {
      "dependsOn": [
        "//#runtime:smoke",
        "@study/desktop#fmt:check",
        "@study/desktop#lint",
        "@study/desktop#deny",
        "@study/desktop#test",
        "@study/desktop#docs"
      ],
      "cache": false
    },
    "//#check:javascript": {
      "dependsOn": [
        "@study/client#typecheck",
        "@study/tooling#typecheck",
        "@study/client#test",
        "@study/ui#test",
        "@study/tooling#test",
        "@study/testing#test",
        "@study/client#build"
      ],
      "cache": false
    },
    "//#check:server": {
      "dependsOn": [
        "@study/server#test",
        "@study/contracts#test",
        "@study/localization#test",
        "@study/theme#test",
        "@study/integrations#test"
      ],
      "cache": false
    },
    "//#desktop:runtime": {
      "cache": false,
      "envMode": "loose",
      "inputs": [
        "package.json",
        "bun.lock",
        "apps/*/package.json",
        "packages/*/package.json",
        "tooling/package.json",
        "tooling/scripts/release/prepare-runtime.ts",
        "apps/server/src/**",
        "packages/contracts/src/**",
        "packages/db/src/**",
        "packages/db/drizzle/**",
        "packages/integrations/src/**",
        "packages/localization/src/**",
        "packages/theme/src/**"
      ]
    },
    "//#runtime:smoke": {
      "dependsOn": ["//#desktop:runtime"],
      "cache": false,
      "envMode": "loose",
      "inputs": ["tooling/scripts/release/smoke_runtime.py"]
    },
    "//#gen:theme:check": {
      "cache": false,
      "inputs": ["packages/theme/src/**", "tooling/scripts/development/generate-theme-css.ts"]
    },
    "//#check:generated": {
      "dependsOn": ["//#gen:theme:check", "@study/db#gen:check"],
      "cache": false
    },
    "//#check:hygiene": {
      "dependsOn": ["//#check:global", "//#check:generated"],
      "cache": false
    },
    "//#check:database": {
      "dependsOn": ["@study/db#test"],
      "cache": false
    }
  },
  "futureFlags": {
    "affectedUsingTaskInputs": true
  }
}
